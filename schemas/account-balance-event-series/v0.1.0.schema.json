{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ea-research-lab:schema:account-balance-event-series:0.1.0",
  "title": "Account Balance Event Series 0.1.0",
  "description": "Ordered account balance observations reported after source events. It is not an equity or continuously sampled time series.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "currency",
    "time_basis",
    "observations"
  ],
  "properties": {
    "schema_name": {
      "const": "account-balance-event-series"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "time_basis": {
      "const": "source_local_time_without_offset"
    },
    "observations": {
      "description": "Observations in deterministic source order; sequence disambiguates equal local times.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/observation"
      }
    }
  },
  "$defs": {
    "money": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]*)\\.[0-9]{2}$"
    },
    "local_time": {
      "description": "Source-local wall-clock time; no UTC or offset claim is made.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$"
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "source_record_id",
        "local_time",
        "balance"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "source_record_id": {
          "type": "string",
          "minLength": 1
        },
        "local_time": {
          "$ref": "#/$defs/local_time"
        },
        "balance": {
          "$ref": "#/$defs/money"
        }
      }
    }
  }
}
