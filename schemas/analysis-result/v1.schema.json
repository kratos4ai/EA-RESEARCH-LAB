{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ea-research-lab.local/schemas/analysis-result/v1.schema.json",
  "title": "AnalysisResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "analysis_version",
    "subject",
    "created_at",
    "provenance",
    "result"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "analysis_id": {
      "type": "string",
      "minLength": 1
    },
    "analysis_version": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "type": "object"
    },
    "result": {
      "type": "object"
    }
  }
}
