{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ea-research-lab.local/schemas/artifact-manifest/v1.schema.json",
  "title": "ArtifactManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "name",
    "source_revision",
    "binary_sha256",
    "built_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "binary_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "compiler": {
      "type": "object"
    },
    "built_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    }
  }
}
