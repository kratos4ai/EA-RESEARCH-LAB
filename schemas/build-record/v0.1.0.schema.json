{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ea-research-lab:schema:build-record:0.1.0",
  "title": "Build Record 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "build_record_id",
    "source_revision",
    "build_configuration_id",
    "build_configuration",
    "status"
  ],
  "properties": {
    "schema_name": {
      "const": "build-record"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "build_record_id": {
      "$ref": "urn:ea-research-lab:schema:common:1.0.0#/$defs/build_record_id"
    },
    "source_revision": {
      "$ref": "#/$defs/source_revision"
    },
    "build_configuration_id": {
      "$ref": "urn:ea-research-lab:schema:common:1.0.0#/$defs/environment_configuration_id"
    },
    "build_configuration": {
      "$ref": "#/$defs/schema_referenced_payload"
    },
    "status": {
      "enum": ["succeeded", "failed"]
    },
    "artifact_id": {
      "$ref": "urn:ea-research-lab:schema:common:1.0.0#/$defs/artifact_id"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["artifact_id"]
      },
      "else": {
        "not": {
          "required": ["artifact_id"]
        }
      }
    }
  ],
  "$defs": {
    "source_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vcs_kind", "repository", "revision", "is_dirty"],
      "properties": {
        "vcs_kind": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "is_dirty": {
          "type": "boolean"
        }
      }
    },
    "schema_referenced_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "value"],
      "properties": {
        "schema_ref": {
          "$ref": "urn:ea-research-lab:schema:common:1.0.0#/$defs/schema_ref"
        },
        "value": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
