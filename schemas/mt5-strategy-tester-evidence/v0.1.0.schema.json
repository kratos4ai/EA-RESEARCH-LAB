{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ea-research-lab:schema:mt5-strategy-tester-evidence:0.1.0",
  "title": "MT5 Strategy Tester Evidence 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "provider",
    "terminal_digest",
    "terminal_version",
    "process_started",
    "timed_out",
    "exit_code",
    "duration_ms",
    "ownership_established",
    "owned_processes_stopped",
    "config_loaded",
    "report_observed",
    "terminal_log_observed",
    "tester_log_observed",
    "log_encoding",
    "completion"
  ],
  "properties": {
    "schema_name": {"const": "mt5-strategy-tester-evidence"},
    "schema_version": {"const": "0.1.0"},
    "provider": {"const": "metatrader5-strategy-tester"},
    "terminal_digest": {
      "$ref": "urn:ea-research-lab:schema:common:1.0.0#/$defs/sha256_digest"
    },
    "terminal_version": {"type": ["string", "null"], "minLength": 1},
    "process_started": {"type": "boolean"},
    "timed_out": {"type": "boolean"},
    "exit_code": {"type": ["integer", "null"]},
    "duration_ms": {"type": "integer", "minimum": 0},
    "ownership_established": {"type": "boolean"},
    "owned_processes_stopped": {"type": ["boolean", "null"]},
    "config_loaded": {"type": ["boolean", "null"]},
    "report_observed": {"type": "boolean"},
    "terminal_log_observed": {"type": "boolean"},
    "tester_log_observed": {"type": "boolean"},
    "log_encoding": {"enum": ["utf-16le", null]},
    "completion": {"enum": ["completed", "failed", "ambiguous", "timeout"]}
  }
}
