{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ea-research-lab.local/schemas/test-definition/v1.schema.json",
  "title": "TestDefinitionV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "test_id",
    "artifact_id",
    "execution",
    "inputs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "test_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "execution": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "symbol",
        "timeframe",
        "date_from",
        "date_to"
      ],
      "properties": {
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "timeframe": {
          "type": "string",
          "minLength": 1
        },
        "date_from": {
          "type": "string",
          "format": "date"
        },
        "date_to": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": true
    },
    "metadata": {
      "type": "object"
    }
  }
}
